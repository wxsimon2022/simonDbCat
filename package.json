{
  "name": "mydb",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "node server/index.cjs",
    "dev": "concurrently -n client,server -c blue,green \"npm run dev:client\" \"npm run dev:server\"",
    "build": "vite build",
    "electron:dev": "concurrently -k \"npm run dev:client\" \"sleep 2 && npx electron .\"",
    "electron:build": "npm run build && npx electron-builder",
    "preview": "vite preview",
    "server": "node server/index.cjs",
    "release": "bash scripts/release.sh",
    "release:upload": "bash scripts/release.sh --upload-only"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.6",
    "element-plus": "^2.14.0",
    "express": "^4.22.2",
    "mysql2": "^3.22.4",
    "pinia": "^3.0.4",
    "vue": "^3.5.34",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^9.2.1",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vue-tsc": "^3.2.8"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.mydb.app",
    "productName": "simonDbCat",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server/data",
        "to": "server/data",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
